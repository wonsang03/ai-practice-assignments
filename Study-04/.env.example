# 이 파일을 복사해 .env로 저장한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)
# BAZE API 게이트웨이 키 (안내: https://docs.factchat.kr)
BAZE_API_KEY=

# 키는 발급한 BAZE 배포 주소에서만 동작합니다. 다른 주소를 안내받았다면 여기만 바꾸세요.
BAZE_BASE_URL=https://api.baze.co/v1/gateway

# 모델 ID는 BAZE 모델 목록(GET /models/)에 있는 것으로 바꿀 수 있습니다. 404·403이 나오면 다른 ID로 바꾸세요.
VISION_MODEL=google/gemma-4-31B-it
TEXT_MODEL=gpt-6-luna
